PORT=3000
HOST=127.0.0.1

# Add the HTTPS dashboard origin when accessed through a reverse proxy.
# Multiple origins are comma-separated.
CORS_ORIGINS=

# Read-only by default. Only set true if you explicitly need the Send Message feature.
ALLOW_SEND_MESSAGES=false

# Historical messages are held in memory until you enable a group.
HISTORY_BUFFER_PER_GROUP=500
HISTORY_BUFFER_TOTAL=5000

# Direct messages also remain in a separate capped memory buffer until selected.
DM_HISTORY_BUFFER_PER_CHAT=500
DM_HISTORY_BUFFER_TOTAL=5000

# LLM Provider API Keys (Optional here; can also be configured via Web UI Settings)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Active Provider Options: openai, gemini, anthropic, ollama
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.0-flash

# WhatsApp Session Storage Directory
AUTH_FOLDER=./auth_info
MEDIA_FOLDER=./downloads/media
DB_PATH=./data/whatsapp_bot.db

# Transient WhatsApp disconnects retry indefinitely with exponential backoff.
WHATSAPP_RECONNECT_BASE_DELAY_MS=5000
WHATSAPP_RECONNECT_MAX_DELAY_MS=300000
WHATSAPP_RECONNECT_WATCHDOG_MS=60000

# Runtime backup location and retention.
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=14

# Mrrjestic Oracle quotation API. Keep the token server-side only.
ORACLE_PRICING_URL=https://tyre-pricing.onrender.com
ORACLE_API_TOKEN=
