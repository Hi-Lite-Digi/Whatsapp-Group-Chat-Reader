    "backup": "node scripts/backup-runtime.mjs",
    "import:web-history": "node scripts/import-web-history.mjs",
    "healthcheck": "node scripts/healthcheck.mjs",
    "test": "node --test",
    "setup": "npm install && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@google/generative-ai": "^0.22.0",
    "@whiskeysockets/baileys": "^6.7.24",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mammoth": "^1.9.0",
    "openai": "^4.83.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.475.0",
    "nodemon": "^3.1.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.1.0"
