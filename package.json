{
  "name": "whatsapp-group-llm-extractor",
  "version": "1.0.0",
  "description": "Real-time WhatsApp Group Chat listener, multimodal document processor, LLM extraction engine, and SQLite database dashboard",
  "main": "src/server/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "nodemon src/server/index.js",
    "build:client": "vite build",
